# Supabase Postgres — from your Supabase project settings > Database
DATABASE_URL="postgresql://postgres:[password]@[host]:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:[password]@[host]:5432/postgres"

# Supabase Storage
SUPABASE_URL="https://[project-ref].supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""

# Clerk — from your Clerk project settings > API Keys
CLERK_SECRET_KEY=""
CLERK_PUBLISHABLE_KEY=""
CLERK_WEBHOOK_SECRET="" # from Clerk Dashboard > Webhooks > your endpoint

# Server
PORT=3000
NODE_ENV=development

# Shared secret for the GitHub Actions cron to call protected /internal/* routes
INTERNAL_CRON_SECRET=""

# Set to "true" only once real Supabase credentials above are filled in AND
# prisma/rls.sql has been applied via the dedicated app_user role (not the
# postgres superuser — see the warning at the top of that file). Enables the
# DB-backed cross-org isolation suite in tests/isolation.test.ts.
RUN_DB_TESTS="false"
